# Copy this file to `.env` and fill in real values.
# NEVER commit your real .env file (it is listed in .gitignore).

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini models (defaults are fine)
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# Postgres connection (matches docker-compose.yml)
DATABASE_URL=postgresql://helpdesk:helpdesk_pw@localhost:5433/helpdesk
